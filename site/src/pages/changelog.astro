---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

// Every release, newest first. Each entry is written and committed by the
// Release workflow when the release goes live, so this page updates itself.
const parse = (v: string) => v.split(/[.-]/).map((p) => (/^\d+$/.test(p) ? Number(p) : p));
const newer = (a: string, b: string) => {
  const x = parse(a), y = parse(b);
  for (let i = 0; i < Math.max(x.length, y.length); i++) {
    if (x[i] === undefined) return -1; // 1.2.0 is newer than 1.2.0-beta.1
    if (y[i] === undefined) return 1;
    if (x[i] !== y[i]) return x[i]! > y[i]! ? 1 : -1;
  }
  return 0;
};
const entries = (await getCollection('changelog')).sort((a, b) => newer(b.data.version, a.data.version));
const rendered = await Promise.all(entries.map(async (e) => ({ e, Content: (await render(e)).Content })));
const when = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const anchor = (v: string) => 'v' + v.replace(/\./g, '-');
---

<Base title="Changelog" description="What's new in every Linx release: new features, improvements and fixes.">
  <section class="container head">
    <p class="eyebrow">Changelog</p>
    <h1>What's new in Linx</h1>
    <p class="lede">Every release, newest first. Updating your server: run the install command again, or see <a href="/docs/server-settings">Server settings</a>.</p>
  </section>

  <section class="container"><div class="list">
    {rendered.length === 0 && <p>No releases yet.</p>}
    {
      rendered.map(({ e, Content }) => (
        <article class="release" id={anchor(e.data.version)}>
          <header>
            <h2><a href={`#${anchor(e.data.version)}`}>Linx {e.data.version}</a></h2>
            <p class="meta">
              {when(e.data.date)}
              {e.data.channel === 'beta' && <span class="beta">Beta</span>}
              · <a href={`https://github.com/linxpbx/linx/releases/tag/v${e.data.version}`} rel="noopener">Release on GitHub</a>
            </p>
          </header>
          <div class="body"><Content /></div>
        </article>
      ))
    }
  </div></section>

  <style>
    .head { padding-top: clamp(2.5rem, 6vw, 4rem); }
    .lede { font-size: 1.15rem; max-width: 60ch; }
    .list { display: grid; gap: 1.2rem; padding-block: 1.5rem 1rem; max-width: 820px; }
    .release {
      background: var(--bg-raised);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 1.5rem 1.6rem;
    }
    .release h2 { font-size: 1.5rem; margin-bottom: 0.2rem; }
    .release h2 a { color: var(--fg); }
    .meta { font-size: 0.9rem; color: var(--fg-faint); margin: 0 0 1rem; }
    .beta {
      font-family: var(--font-display); font-weight: 600; font-size: 0.75rem; color: var(--warn);
      border: 1px solid currentColor; border-radius: var(--r-pill); padding: 0.05em 0.6em; margin-left: 0.4em;
    }
    .body :global(h2), .body :global(h3) { font-size: 1.1rem; margin-top: 1.2rem; }
    .body :global(ul) { padding-left: 1.2rem; }
    .body :global(li) { color: var(--fg-muted); margin-bottom: 0.35rem; }
    .body :global(p) { color: var(--fg-muted); }
  </style>
</Base>
