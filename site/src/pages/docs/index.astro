---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { AUDIENCE_LABEL, docPages, GROUPS } from '../../lib/docs';

const pages = await docPages();
const sections = GROUPS.map((g) => [g, pages.filter((p) => p.group === g)] as const).filter(([, items]) => items.length);
---

<DocsLayout title="Docs & help" description="Guides for installing, using and running Linx — the same help that's built into Linx.">
  <h1>Docs &amp; help</h1>
  <p class="lede">Guides for installing, using and running Linx. They're the same guides as the Help built into Linx, so what you read here matches what you see on your own server.</p>

  {
    sections.map(([name, items]) => (
      <section class="group">
        <h2>{name}</h2>
        <div class="doc-cards">
          {items.map((d) => (
            <a class="doc-card" href={`/docs/${d.id}`}>
              <h3>{d.title}</h3>
              {AUDIENCE_LABEL[d.audience] && <span class="aud">{AUDIENCE_LABEL[d.audience]}</span>}
              {d.description && <p>{d.description}</p>}
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <style>
    .lede { font-size: 1.15rem; color: var(--fg-faint); margin-bottom: 1.8rem; }
    .group + .group { margin-top: 2.2rem; }
    .group h2 { font-size: 1.35rem; margin-bottom: 0.9rem; }
    .doc-cards { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; }
    .doc-card {
      display: block;
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 1.2rem 1.3rem;
      background: var(--bg-raised);
      text-decoration: none;
    }
    .doc-card:hover { border-color: var(--accent); text-decoration: none; }
    .doc-card h3 { margin-bottom: 0.3rem; color: var(--fg); font-size: 1.08rem; }
    .doc-card p { margin: 0.3rem 0 0; font-size: 0.92rem; color: var(--fg-muted); }
    .aud { font-family: var(--font-display); font-size: 0.75rem; font-weight: 600; color: var(--accent); }
    @media (max-width: 640px) { .doc-cards { grid-template-columns: minmax(0, 1fr); } }
  </style>
</DocsLayout>
