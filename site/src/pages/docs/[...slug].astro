---
import { render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { AUDIENCE_LABEL, docPages } from '../../lib/docs';

export async function getStaticPaths() {
  return (await docPages()).map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page.entry);
// Help guides open with their own "# Title"; the website's pages don't.
const ownTitle = page.entry.collection === 'help';
const audience = AUDIENCE_LABEL[page.audience];
---

<DocsLayout title={page.title} description={page.description} current={page.id}>
  {audience && <p class="audience">{audience}</p>}
  {!ownTitle && <h1>{page.title}</h1>}
  {!ownTitle && page.description && <p class="lede">{page.description}</p>}
  <Content />
</DocsLayout>

<style>
  .lede {
    font-size: 1.15rem;
    color: var(--fg-faint);
    margin-top: -0.3rem;
    margin-bottom: 1.5rem;
  }
  .audience {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.78rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-radius: var(--r-pill);
    padding: 0.2em 0.8em;
    margin: 0 0 0.8rem;
  }
</style>
