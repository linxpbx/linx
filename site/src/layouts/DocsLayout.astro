---
import Base from './Base.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  current?: string;
}
const { title, description, current } = Astro.props;

const docs = (await getCollection('docs')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

const sections = new Map<string, typeof docs>();
for (const d of docs) {
  const list = sections.get(d.data.section) ?? [];
  list.push(d);
  sections.set(d.data.section, list);
}
---

<Base title={title} description={description}>
  <div class="container docs-shell">
    <aside class="sidebar">
      <nav aria-label="Documentation">
        {
          [...sections].map(([name, items]) => (
            <div class="group">
              <h4>{name}</h4>
              <ul>
                {items.map((d) => (
                  <li>
                    <a href={`/docs/${d.id}`} aria-current={current === d.id ? 'page' : undefined}>
                      {d.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>
    <article class="doc-content">
      <slot />
    </article>
  </div>

  <style>
    .docs-shell {
      display: grid;
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 3rem;
      padding-block: clamp(2rem, 5vw, 3.5rem);
      align-items: start;
    }
    .sidebar {
      position: sticky;
      top: 82px;
    }
    .group + .group { margin-top: 1.5rem; }
    .sidebar h4 {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--fg-faint);
      margin-bottom: 0.6rem;
    }
    .sidebar ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
    .sidebar a {
      display: block;
      color: var(--fg-muted);
      font-size: 0.96rem;
      padding: 0.35em 0.7em;
      border-radius: var(--r-sm);
      border-left: 2px solid transparent;
    }
    .sidebar a:hover { background: var(--bg-raised); text-decoration: none; color: var(--fg); }
    .sidebar a[aria-current='page'] {
      color: var(--accent);
      border-left-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 8%, transparent);
    }

    .doc-content { max-width: 72ch; }
    .doc-content :global(h1) { margin-bottom: 0.6em; }
    .doc-content :global(h2) { margin-top: 2rem; font-size: 1.5rem; }
    .doc-content :global(h3) { margin-top: 1.6rem; }
    .doc-content :global(p),
    .doc-content :global(li) { color: var(--fg-muted); }
    .doc-content :global(a) { text-decoration: underline; text-underline-offset: 2px; }
    .doc-content :global(ul),
    .doc-content :global(ol) { padding-left: 1.3rem; }
    .doc-content :global(li) { margin-bottom: 0.4rem; }
    .doc-content :global(code) {
      background: color-mix(in srgb, var(--accent) 12%, transparent);
      padding: 0.12em 0.4em;
      border-radius: 6px;
      font-size: 0.9em;
    }
    .doc-content :global(pre) {
      background: var(--dark);
      color: #eef1f5;
      padding: 1rem 1.1rem;
      border-radius: var(--r-md);
      overflow-x: auto;
      border: 1px solid #2a2f37;
    }
    .doc-content :global(pre code) { background: none; padding: 0; color: inherit; }
    .doc-content :global(blockquote) {
      margin: 1.2rem 0;
      padding: 0.6rem 1rem;
      border-left: 3px solid var(--accent);
      background: var(--bg-raised);
      border-radius: 0 var(--r-sm) var(--r-sm) 0;
    }

    @media (max-width: 820px) {
      .docs-shell { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
      .sidebar {
        position: static;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1rem;
      }
      .sidebar nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
    }
  </style>
</Base>
