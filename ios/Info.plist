<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The keys Xcode has no build setting for. Everything else about this
	     app's Info.plist is still generated from the build settings
	     (GENERATE_INFOPLIST_FILE), and Xcode merges those into this file. -->

	<!-- Export compliance (docs/PHASE2.md §14 item 9). Every upload is asked
	     whether the app uses non-exempt encryption, and an answer missing
	     here stops each TestFlight build until somebody answers it by hand in
	     App Store Connect. Linx uses standard encryption only — TLS for
	     everything it says, DTLS-SRTP for the sound and the picture, and
	     Apple's own Secure Enclave for this phone's key — which is exempt, so
	     the answer is no. (France asks separately, in App Store Connect.) -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- What may run while the app isn't on the display (docs/PHASE2.md §14
	     item 7). Only these two, and both are what the app actually does:
	       voip  — PushKit wakes the app for a call and it reports it to
	               CallKit at once.
	       audio — a call that is already up keeps its sound while the
	               person puts the phone to their ear, locks it, or looks
	               at something else.
	     Nothing else is asked for: no background fetch, no location, no
	     processing. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
		<string>audio</string>
	</array>
</dict>
</plist>
