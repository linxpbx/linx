<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications (docs/PHASE2.md §5): PushKit wakes the app for a
	     call, and ordinary notifications carry a missed call or a new
	     voicemail. Signing replaces "development" with "production" for a
	     TestFlight or App Store build; the app reads which it got out of its
	     own provisioning profile (Core/Push/PushEnvironment.swift). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
