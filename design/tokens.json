{
  "$comment": "Single source of design tokens. Run `make tokens` after editing; never edit the generated CSS or Swift assets by hand. See docs/ui/DESIGN_TOKENS.md.",
  "color": {
    "accent":       { "light": "#1F5FD6", "dark": "#7FB0FF", "use": "links, selected nav, focus rings, accent text" },
    "brand-fill":   { "light": "#1F5FD6", "dark": "#1F5FD6", "use": "filled primary buttons" },
    "on-brand":     { "light": "#FFFFFF", "dark": "#FFFFFF", "use": "text/icons on brand-fill" },
    "bg":           { "light": "#F4F3EF", "dark": "#17191E", "use": "app background" },
    "surface":      { "light": "#FFFFFF", "dark": "#22252C", "use": "cards, tables, panels" },
    "surface-dark": { "light": "#17191E", "dark": "#17191E", "use": "sidebar, in-call screen, meeting stage" },
    "on-surface-dark": { "light": "#F4F3EF", "dark": "#F4F3EF", "use": "text on surface-dark" },
    "accent-on-dark": { "light": "#7FB0FF", "dark": "#7FB0FF", "use": "Signal: logo X, links and accents on surface-dark" },
    "text":         { "light": "#17191E", "dark": "#F4F3EF", "use": "body text" },
    "text-muted":   { "light": "#5B5F68", "dark": "#A6AAB3", "use": "secondary text" },
    "border":       { "light": "#E3E1DA", "dark": "#343842", "use": "dividers, outlines" },
    "call":         { "light": "#1E8E4E", "dark": "#1E8E4E", "use": "answer button, available" },
    "on-call":      { "light": "#FFFFFF", "dark": "#FFFFFF", "use": "icon on call" },
    "end":          { "light": "#C53030", "dark": "#C53030", "use": "hang up, destructive, alerts" },
    "on-end":       { "light": "#FFFFFF", "dark": "#FFFFFF", "use": "text/icon on end" }
  },
  "status": {
    "available": { "light": "#1E8E4E", "dark": "#1E8E4E" },
    "busy":      { "light": "#C53030", "dark": "#E05252" },
    "ringing":   { "light": "#C27A12", "dark": "#C27A12" },
    "away":      { "light": "#9C7F0A", "dark": "#B8960C" },
    "dnd":       { "light": "#7A3FC4", "dark": "#9D6FE3" },
    "push":      { "light": "#5A7A9A", "dark": "#5A7A9A" },
    "offline":   { "light": "#8A8E96", "dark": "#8A8E96" },
    "meeting":   { "light": "#1F5FD6", "dark": "#5B8FEA" }
  },
  "font": {
    "display": "\"Instrument Sans\", system-ui, sans-serif",
    "body":    "\"IBM Plex Sans\", system-ui, sans-serif",
    "mono":    "\"IBM Plex Mono\", ui-monospace, monospace"
  },
  "space":  { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "full": 9999 },
  "contrast": [
    { "fg": "color.text",       "bg": "color.bg",           "min": 4.5 },
    { "fg": "color.text",       "bg": "color.surface",      "min": 4.5 },
    { "fg": "color.text-muted", "bg": "color.bg",           "min": 4.5 },
    { "fg": "color.text-muted", "bg": "color.surface",      "min": 4.5 },
    { "fg": "color.accent",     "bg": "color.bg",           "min": 4.5 },
    { "fg": "color.accent",     "bg": "color.surface",      "min": 4.5 },
    { "fg": "color.on-brand",   "bg": "color.brand-fill",   "min": 4.5 },
    { "fg": "color.on-end",     "bg": "color.end",          "min": 4.5 },
    { "fg": "color.on-call",    "bg": "color.call",         "min": 3.0 },
    { "fg": "color.on-surface-dark", "bg": "color.surface-dark", "min": 4.5 },
    { "fg": "color.accent-on-dark", "bg": "color.surface-dark", "min": 4.5 },
    { "fg": "status.available", "bg": "color.surface",      "min": 3.0 },
    { "fg": "status.busy",      "bg": "color.surface",      "min": 3.0 },
    { "fg": "status.ringing",   "bg": "color.surface",      "min": 3.0 },
    { "fg": "status.away",      "bg": "color.surface",      "min": 3.0 },
    { "fg": "status.dnd",       "bg": "color.surface",      "min": 3.0 },
    { "fg": "status.push",      "bg": "color.surface",      "min": 3.0 },
    { "fg": "status.offline",   "bg": "color.surface",      "min": 3.0 },
    { "fg": "status.meeting",   "bg": "color.surface",      "min": 3.0 }
  ]
}
